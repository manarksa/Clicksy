# انسخوا هذا الملف باسم .env ثم عبّئوا القيم الحقيقية
# Copy this file to .env and fill in real values. Never commit .env.

# ── MySQL ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=clicksy_user
DB_PASSWORD=password-of-clicksy_user
DB_NAME=clicksy

# ── Owner account (created automatically on first start) ──
OWNER_NAME=Studio Owner
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me-please

# ── Email (Gmail) ─────────────────────────────────────
# Leave SMTP_USER empty to print codes in the server terminal instead of emailing.
# Gmail needs an *App password*: Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Clicksy <your-gmail@gmail.com>

# ── Server ────────────────────────────────────────────
PORT=4000
