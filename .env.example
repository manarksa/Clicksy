# انسخوا هذا الملف باسم .env ثم عبّئوا القيم الحقيقية
# Copy this file to .env (local) or .env.tidb (cloud copy/test). Never commit them.
# On Render, put the same names under Environment instead of a file.

# ── Database ──────────────────────────────────────────
# Local MySQL:
DB_HOST=localhost
DB_PORT=3306
DB_USER=clicksy_user
DB_PASSWORD=password-of-clicksy_user
DB_NAME=clicksy
DB_SSL=
# TiDB Cloud Starter (from the cluster's "Connect" dialog):
#   DB_HOST=gateway01.<region>.prod.aws.tidbcloud.com
#   DB_PORT=4000
#   DB_USER=<prefix>.root
#   DB_PASSWORD=<generated password>
#   DB_NAME=clicksy
#   DB_SSL=true
# Aiven MySQL (private CA — download ca.pem from the service page, or use certs/aiven-ca.pem):
#   DB_HOST=mysql-xxxx.a.aivencloud.com
#   DB_PORT=<port>
#   DB_USER=avnadmin
#   DB_PASSWORD=<from the Aiven console>
#   DB_NAME=defaultdb
#   DB_SSL=true
#   DB_SSL_CA=certs/aiven-ca.pem
DB_SSL_CA=

# ── Owner account (created automatically on first start) ──
OWNER_NAME=Studio Owner
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me-please

# ── Email ─────────────────────────────────────────────
# MAIL_PROVIDER: brevo | smtp | console
# (empty = brevo if BREVO_API_KEY is set, else smtp if SMTP_USER is set, else print in terminal)
MAIL_PROVIDER=
MAIL_FROM=Clicksy <verified-sender@example.com>

# Brevo HTTPS API — use this on Render (free Render blocks SMTP ports):
BREVO_API_KEY=

# Gmail SMTP — fine for local use. Needs a Gmail *App password*:
# Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ── Server ────────────────────────────────────────────
# Render sets PORT itself. Set NODE_ENV=production there (secure cookies, proxy trust).
PORT=4000
NODE_ENV=
# READ_ONLY=true pauses sign-ups, sign-ins and bookings (used while moving the database).
READ_ONLY=
